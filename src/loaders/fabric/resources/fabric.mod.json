{
  "schemaVersion": 1,
  "id": "selfaware",
  "version": "${version}",
  "name": "Selfaware",
  "description": "See your own nametag in third person.",
  "authors": ["Kaan"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.kaan.selfaware.SelfawareClient"],
    "voicechat": ["dev.kaan.selfaware.SimpleVoiceChatPlugin"],
    "modmenu": ["dev.kaan.selfaware.SelfawareModMenu"]
  },
  "mixins": ["selfaware.mixins.json"],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "=${minecraft}",
    "java": ">=${java}",
    "fabric-api": ">=${fabricApiVersion}",
    "modmenu": ">=${modMenuVersion}"
  }
}
